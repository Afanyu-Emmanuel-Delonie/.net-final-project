@page
@model FERW.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="auth-shell">
    <partial name="_AuthVisual" model="@("The table updates itself.")" />
    <div class="auth-form-panel">
        <div class="auth-card">
            <a class="auth-back" asp-page="/Account/Login">← Back to sign in</a>
            <h1>Reset your password</h1>
            <p class="auth-card__subtitle">Enter your email and we'll send a link to reset it.</p>

            @if (Model.Sent)
            {
                <p class="auth-switch">Check your email for a link to reset your password.</p>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-field">
                        <label asp-for="Input.Email">Email address</label>
                        <input asp-for="Input.Email" autocomplete="email" placeholder="you@ferwafa.rw" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn-ffms btn-ffms-green auth-submit">Send reset link</button>
                </form>
            }
            <p class="auth-switch">Remembered it? <a asp-page="/Account/Login">Sign in</a></p>
        </div>
    </div>
</div>
