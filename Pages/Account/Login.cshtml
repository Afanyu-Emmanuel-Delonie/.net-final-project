@page
@model FERW.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Staff sign in";
}

<div class="auth-shell">
    <partial name="_AuthVisual" model="@("Every club, player and match in Rwandan football, in one place.")" />
    <div class="auth-form-panel">
        <div class="auth-card">
            <a class="auth-back" asp-page="/Index">← Back to FFMS</a>
            <h1>Staff sign in</h1>
            <p class="auth-card__subtitle">Sign in to register players, approve transfers and run matchday.</p>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-field">
                    <label asp-for="Input.Email">Email address</label>
                    <input asp-for="Input.Email" autocomplete="email" placeholder="you@ferwafa.rw" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="auth-row-split">
                    <label class="auth-check"><input asp-for="Input.RememberMe" /> Remember me</label>
                    <a asp-page="/Account/ForgotPassword">Forgot password?</a>
                </div>
                <button type="submit" class="btn-ffms btn-ffms-green auth-submit">Sign in</button>
            </form>
            <p class="auth-switch">Need an account? <a asp-page="/Account/Register">Request staff access</a></p>

            <div class="demo-accounts">
                <p class="demo-accounts__title">Demo accounts</p>
                <p class="demo-accounts__hint">This prototype has no real sign-in yet — jump straight into a role to see its workspace.</p>

                <div class="demo-account">
                    <span class="demo-avatar" aria-hidden="true">JN</span>
                    <span class="demo-account__body">
                        <strong>Jean Claude Niyonzima</strong>
                        <small>Federation admin</small>
                    </span>
                    <a class="btn-ffms btn-ffms-outline" asp-page="/Admin/Dashboard">Continue</a>
                </div>
                <div class="demo-account">
                    <span class="demo-avatar" aria-hidden="true">AU</span>
                    <span class="demo-account__body">
                        <strong>Alice Uwase</strong>
                        <small>League manager</small>
                    </span>
                    <a class="btn-ffms btn-ffms-outline" asp-page="/League/Dashboard">Continue</a>
                </div>
                <div class="demo-account">
                    <span class="demo-avatar" aria-hidden="true">DU</span>
                    <span class="demo-account__body">
                        <strong>Diane Uwimana</strong>
                        <small>Club manager, Rayon Sports</small>
                    </span>
                    <a class="btn-ffms btn-ffms-outline" asp-page="/Club/Dashboard">Continue</a>
                </div>
                <div class="demo-account">
                    <span class="demo-avatar" aria-hidden="true">PS</span>
                    <span class="demo-account__body">
                        <strong>Patrick Sendegeya</strong>
                        <small>Referee manager</small>
                    </span>
                    <a class="btn-ffms btn-ffms-outline" asp-page="/RefereeManager/Dashboard">Continue</a>
                </div>
            </div>
        </div>
    </div>
</div>
