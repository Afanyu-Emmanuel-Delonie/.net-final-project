<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | FFMS</title>
    <link rel="icon" type="image/svg+xml" href="~/image/logo-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["HasHero"] as bool? == true ? "has-hero" : "")">
    <a class="skip-link visually-hidden-focusable" href="#main">Skip to main content</a>

    <header class="site-header" id="siteHeader">
        <div class="container-ffms site-header__inner">
            <a class="brand" asp-page="/Index" aria-label="FFMS home">
                <img src="~/image/logo-mark.svg" alt="" width="34" height="39" />
                <span class="brand__name">FFMS</span>
            </a>
            <nav class="site-nav" id="siteNav" aria-label="Main">
                <ul>
                    <li><a href="/#results">Results</a></li>
                    <li><a href="/#standings">Standings</a></li>
                    <li><a href="/#fixtures">Fixtures</a></li>
                    <li class="site-nav__signin-item"><a class="btn-ffms btn-ffms-green" href="/Account/Login" style="color:#fff">Sign in</a></li>
                </ul>
            </nav>
            <div class="site-header__actions">
                <a class="btn-ffms btn-ffms-green site-header__cta" href="/Account/Login">Sign in</a>
                <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="siteNav" aria-label="Open menu">☰</button>
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer on-dark">
        <div class="container-ffms site-footer__inner">
            <div class="site-footer__brand">
                <img src="~/image/logo-mark.svg" alt="" width="30" height="35" />
                <p>FFMS: fixtures, results and registrations for Rwandan football, in one place.</p>
            </div>
            <nav aria-label="Footer">
                <ul>
                    <li><a href="/#results">Results</a></li>
                    <li><a href="/#standings">Standings</a></li>
                    <li><a href="/#fixtures">Fixtures</a></li>
                    <li><a href="/Account/Login">Staff sign in</a></li>
                </ul>
            </nav>
            <p class="site-footer__note">AUCA .NET project, Group 1, @DateTime.Now.Year. Modelled on FERWAFA and the Rwanda Premier League; not an official site.</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>