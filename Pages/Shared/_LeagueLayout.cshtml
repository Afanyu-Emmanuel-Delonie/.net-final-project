@{
	var pageTitle = ViewData["Title"] as string ?? "League manager";
	var userName = "Alice Uwase";
	var userRole = "League manager";
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@pageTitle | FFMS league</title>
	<link rel="icon" type="image/svg+xml" href="~/image/logo-mark.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
	@await RenderSectionAsync("Styles", required: false)
</head>
<body class="staff-body">
	<a class="skip-link visually-hidden-focusable" href="#league-main">Skip to main content</a>

	<div class="staff-shell">
		<aside class="staff-sidebar" aria-label="League manager navigation">
			<div class="staff-sidebar__brand">
				<a class="staff-brand" asp-page="/Index" aria-label="FFMS home">
					<img src="~/image/logo-mark.svg" alt="" width="34" height="39" />
					<span>
						<strong>FFMS</strong>
						<small>League manager</small>
					</span>
				</a>
			</div>
			<partial name="_LeagueNavigation" />
		</aside>

		<div class="staff-content">
			<header class="staff-topbar">
				<button class="btn staff-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#league-menu" aria-controls="league-menu">
					<span class="staff-menu-toggle__icon" aria-hidden="true">☰</span>
					<span>Menu</span>
				</button>
				<div class="staff-topbar__title">
					<p class="staff-eyebrow">FFMS league manager</p>
					<h1>@pageTitle</h1>
				</div>
				<div class="staff-user" aria-label="Signed-in user">
					<span class="staff-user__avatar" aria-hidden="true">AU</span>
					<span class="staff-user__details">
						<strong>@userName</strong>
						<small>@userRole</small>
					</span>
				</div>
			</header>

			<main id="league-main" class="staff-main" tabindex="-1">
				@RenderBody()
			</main>
		</div>
	</div>

	<div class="offcanvas offcanvas-start staff-offcanvas" tabindex="-1" id="league-menu" aria-labelledby="league-menu-title">
		<div class="offcanvas-header">
			<h2 class="offcanvas-title" id="league-menu-title">FFMS league menu</h2>
			<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
		</div>
		<div class="offcanvas-body">
			<partial name="_LeagueNavigation" />
		</div>
	</div>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
