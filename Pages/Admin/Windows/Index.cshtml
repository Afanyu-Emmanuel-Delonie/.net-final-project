@page
@model FERW.Pages.Admin.Windows.IndexModel
@{
    ViewData["Title"] = "Registration windows";
}

<div class="staff-page-header">
    <div>
        <h2>Registration windows</h2>
        <p>Open and close registration per category, with start and end dates.</p>
    </div>
    <button class="btn-ffms btn-ffms-green" type="button" data-bs-toggle="modal" data-bs-target="#windowModal" data-window-mode="create">New window</button>
</div>

<section class="staff-card">
    <div class="staff-table-wrap">
        <table class="table staff-table">
            <caption class="visually-hidden">Registration windows by category</caption>
            <thead><tr><th scope="col">Category</th><th scope="col">Opens</th><th scope="col">Closes</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var w in Model.Workspace.Windows)
                {
                    <tr>
                        <th scope="row">@w.Category</th>
                        <td>@w.Opens</td>
                        <td>@w.Closes</td>
                        <td><span class="staff-status @(w.Status == "Open" ? "staff-status--approved" : "staff-status--completed")">@w.Status</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#windowModal"
                                    data-window-mode="edit" data-window-category="@w.Category" data-window-opens="@w.Opens" data-window-closes="@w.Closes">
                                Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade" id="windowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="windowModalTitle">New registration window</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="winCategory">Category</label>
                    <select class="form-select" id="winCategory">
                        @foreach (var cat in FERW.Pages.Admin.Windows.IndexModel.Categories)
                        {
                            <option>@cat</option>
                        }
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="winStart">Start date</label>
                        <input class="form-control" id="winStart" type="text" placeholder="1 Oct 2026" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="winEnd">End date</label>
                        <input class="form-control" id="winEnd" type="text" placeholder="15 Dec 2026" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="windowModalSave" data-bs-dismiss="modal">Save window</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('windowModal');
            if (!modalEl) return;
            modalEl.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var mode = button.getAttribute('data-window-mode');
                var title = document.getElementById('windowModalTitle');
                var saveBtn = document.getElementById('windowModalSave');
                if (mode === 'edit') {
                    title.textContent = 'Edit registration window';
                    saveBtn.textContent = 'Save changes';
                    document.getElementById('winCategory').value = button.getAttribute('data-window-category') || '';
                    document.getElementById('winStart').value = button.getAttribute('data-window-opens') || '';
                    document.getElementById('winEnd').value = button.getAttribute('data-window-closes') || '';
                } else {
                    title.textContent = 'New registration window';
                    saveBtn.textContent = 'Create window';
                    document.getElementById('winStart').value = '';
                    document.getElementById('winEnd').value = '';
                }
            });
        })();
    </script>
}
