@page
@model FERW.Pages.League.Matchday.IndexModel
@{
    ViewData["Title"] = "Matchday control";
    var w = Model.Workspace;
    var inPlay = w.Matches.Count(m => m.Status == "In play");
    var pending = w.Matches.Count(m => m.Status == "Result pending");
}

<div class="staff-page-header">
    <div>
        <h2>Matchday @w.MatchdayPlayed</h2>
        <p>Every match in this matchday, live.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (inPlay > 0)
        {
            <span class="staff-status staff-status--inplay">@inPlay in play</span>
        }
        @if (pending > 0)
        {
            <span class="staff-status staff-status--completed">@pending result pending</span>
        }
    </div>
</div>

<section class="staff-card">
    <div class="staff-card__header"><h3>Saturday 21 – Sunday 22 November 2026</h3></div>
    <div class="staff-card__body">
        <ul class="match-list">
            @foreach (var m in w.Matches)
            {
                <li><partial name="_MatchRow" model="m" /></li>
            }
        </ul>
    </div>
</section>
