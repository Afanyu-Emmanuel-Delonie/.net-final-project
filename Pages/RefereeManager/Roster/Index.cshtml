@page
@model FERW.Pages.RefereeManager.Roster.IndexModel
@using FERW.Services
@{
    ViewData["Title"] = "Referee roster";
    var w = Model.Workspace;
}

<div class="staff-page-header">
    <div>
        <h2>Referee roster</h2>
        <p>All registered match officials, their certification and this season's activity.</p>
    </div>
</div>

<div class="pill-tabs mb-3">
    <a class="@(Model.Filter == "all" ? "is-active" : "")" asp-page="/RefereeManager/Roster/Index" asp-route-filter="all">All (@w.Referees.Count)</a>
    <a class="@(Model.Filter == "active" ? "is-active" : "")" asp-page="/RefereeManager/Roster/Index" asp-route-filter="active">Active (@w.Referees.Count(r => r.Status == "Active"))</a>
    <a class="@(Model.Filter == "unavailable" ? "is-active" : "")" asp-page="/RefereeManager/Roster/Index" asp-route-filter="unavailable">Unavailable (@w.Referees.Count(r => r.Status == "Unavailable"))</a>
    <a class="@(Model.Filter == "fifa" ? "is-active" : "")" asp-page="/RefereeManager/Roster/Index" asp-route-filter="fifa">FIFA-listed (@w.Referees.Count(r => r.Certification == "FIFA-listed"))</a>
    <a class="@(Model.Filter == "applications" ? "is-active" : "")" asp-page="/RefereeManager/Roster/Index" asp-route-filter="applications">Applications (@w.Referees.Count(r => r.Status == "Pending"))</a>
</div>

<section class="staff-card">
    <div class="staff-table-wrap">
        <table class="table staff-table">
            <caption class="visually-hidden">Referee roster</caption>
            <thead><tr><th scope="col">Referee</th><th scope="col">Certification</th><th scope="col">Status</th><th scope="col">Matches this season</th><th scope="col">Cards issued</th><th scope="col">Next matchday</th><th></th></tr></thead>
            <tbody>
                @if (!Model.FilteredReferees.Any())
                {
                    <tr><td colspan="7"><div class="staff-empty"><strong>No referees match this filter.</strong></div></td></tr>
                }
                @foreach (var r in Model.FilteredReferees)
                {
                    <tr>
                        <th scope="row">
                            <a class="club-cell" asp-page="/RefereeManager/Referee/Detail" asp-route-id="@r.Id" style="color:inherit;text-decoration:none;">
                                <span class="person-avatar">@FERW.Pages.RefereeManager.Roster.IndexModel.Initials(r.Name)</span>
                                @r.Name
                            </a>
                        </th>
                        <td><span class="cert-badge @FERW.Pages.RefereeManager.Roster.IndexModel.CertClass(r.Certification)">@r.Certification</span></td>
                        <td><span class="staff-status @FERW.Pages.RefereeManager.Roster.IndexModel.StatusClass(r.Status)">@r.Status</span></td>
                        <td>@r.MatchesThisSeason</td>
                        <td>@r.YellowCards yellow, @r.RedCards red</td>
                        <td>@r.NextMatchday</td>
                        <td class="d-flex gap-2">
                            <button type="button" class="btn-ffms btn-ffms-outline btn-ffms-sm" data-bs-toggle="modal" data-bs-target="#assignModal"
                                    onclick="prepareAssign('@r.Name')">Assign</button>
                            <button type="button" class="btn-ffms btn-ffms-ghost btn-ffms-sm" style="color:var(--ffms-red);" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    onclick="prepareDelete('@r.Name')">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Assign <span id="assignRefName"></span> to a match</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="staff-help mb-2">Matches that still need a referee.</p>
                <select class="form-select">
                    <option>@w.UnassignedMatchLabel</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Assign referee</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Remove <span id="deleteRefName"></span> from the roster?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">They won't be available for new assignments. This doesn't erase their past match history.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Remove referee</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepareAssign(name) { document.getElementById('assignRefName').textContent = name; }
        function prepareDelete(name) { document.getElementById('deleteRefName').textContent = name; }
    </script>
}
